# TaskMagotchi - API Keys
# Copia este archivo a .env y completa tus keys

# Groq API Key (para chat conversacional con la mascota)
# Obtén una gratis en: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=gsk_tu_key_aqui

# Gemini API Key (para verificación de fotos con IA)
# Obtén una gratis en: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIza_tu_key_aqui
