{
  "expo": {
    "name": "taskmagotchi",
    "slug": "taskmagotchi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TaskMagotchi necesita la cámara para verificar tus tareas completadas con foto."
      }
    },
    "android": {
      "package": "com.taskmagotchi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-camera",
      "./plugins/withAppBlocker",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a64aa8cc-993f-4688-83c5-b8f6e74c6bf7"
      }
    },
    "owner": "gr4v1tys-team"
  }
}
